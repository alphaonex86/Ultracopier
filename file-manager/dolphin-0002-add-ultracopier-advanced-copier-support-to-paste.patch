 void DolphinView::pasteToUrl(const QUrl &url)
 {
-    KIO::PasteJob *job = KIO::paste(QApplication::clipboard()->mimeData(), url);
+    QClipboard *clipboard = QApplication::clipboard();
+    const QMimeData *mimeData = clipboard->mimeData();
+    const QList<QUrl> urls = KUrlMimeData::urlsFromMimeData(mimeData);
+    const bool isCut = mimeData->data(QStringLiteral("application/x-kde-cutselection")) == "1";
+
+    if (!urls.isEmpty()) {
+        QLocalSocket socket;
+        socket.connectToServer(QStringLiteral("advanced-copier-") + QString::number(getuid()));
+        socket.waitForConnected();
+        if (socket.state() == QLocalSocket::ConnectedState) {
+            sendRawOrderList(QStringList() << QStringLiteral("protocol") << QStringLiteral("0002"), socket, 1);
+            socket.waitForReadyRead();
+            socket.readAll();
+            QStringList l;
+            l << (isCut ? QStringLiteral("mv") : QStringLiteral("cp"));
+            for (const QUrl &u : urls) {
+                l << u.toString();
+            }
+            l << url.toString();
+            sendRawOrderList(l, socket, 2);
+            socket.waitForBytesWritten();
+            const bool refused = ultracopierRefusedOrder(socket, 2);
+            socket.close();
+            if (!refused) {
+                if (isCut) {
+                    // cleared only now: on a refusal KIO::paste below still needs the clipboard
+                    clipboard->clear(QClipboard::Clipboard);
+                }
+                return;
+            }
+        }
+    }
+
+    // Fallback to standard KIO paste: Ultracopier is not running, or it REFUSED the job (a
+    // protocol it has no copy engine for, sftp:// ...) and transferred nothing at all.
+    KIO::PasteJob *job = KIO::paste(clipboard->mimeData(), url);
     KJobWidgets::setWindow(job, this);
     m_clearSelectionBeforeSelectingNewItems = true;
     m_markFirstNewlySelectedItemAsCurrent = true;
