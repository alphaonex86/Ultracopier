+#include <unistd.h>
+
+static void sendRawOrderList(const QStringList &order, QLocalSocket &socket, quint32 idNextOrder)
+{
+    QByteArray block;
+    QDataStream out(&block, QIODevice::WriteOnly);
+    out.setVersion(QDataStream::Qt_4_4);
+    out << (quint32)0;
+    out << idNextOrder;
+    out << order;
+    out.device()->seek(0);
+    out << (quint32)block.size(); // 4-byte header: Qt6 QByteArray::size() is qsizetype (8B)
+    do {
+        QByteArray blockToSend = block.left(32 * 1024); // 32KB
+        block.remove(0, blockToSend.size());
+        socket.write(blockToSend);
+    } while (block.size());
+}
+
+/* Did Ultracopier REFUSE the order we just sent (reply code 5004)? It answers a cp/mv order only
+ * when the transfer FINISHES, so waiting for that reply would block until the whole copy is done.
+ * All we need to know now is whether it took the job, so we send a cheap "server name?" query right
+ * after the order and wait for ITS reply: the socket is FIFO and Ultracopier answers in the order it
+ * receives, so once the name reply is in, a refusal of the order has necessarily been written too.
+ * Only an explicit refusal returns true -- no answer, or a server that died, counts as accepted, so
+ * a lost reply can never make us copy the same files a second time. */
+static bool ultracopierRefusedOrder(QLocalSocket &socket, quint32 orderId)
+{
+    const quint32 barrierOrderId = orderId + 1;
+    sendRawOrderList(QStringList() << QStringLiteral("server") << QStringLiteral("name?"), socket, barrierOrderId);
+    QByteArray buffer;
+    while (socket.state() == QLocalSocket::ConnectedState) {
+        if (socket.bytesAvailable() <= 0 && !socket.waitForReadyRead(2000)) {
+            return false;
+        }
+        buffer += socket.readAll();
+        while (buffer.size() >= (int)(3 * sizeof(quint32))) {
+            QDataStream in(buffer);
+            in.setVersion(QDataStream::Qt_4_4);
+            quint32 frameSize = 0;
+            quint32 replyOrderId = 0;
+            quint32 returnCode = 0;
+            in >> frameSize >> replyOrderId >> returnCode;
+            if (frameSize < 3 * sizeof(quint32) || (quint32)buffer.size() < frameSize) {
+                break; // the frame is not complete yet
+            }
+            buffer.remove(0, frameSize);
+            if (replyOrderId == orderId && returnCode == 5004) {
+                return true; // refused: nothing was transferred, we have to do it ourselves
+            }
+            if (replyOrderId == barrierOrderId) {
+                return false; // the barrier is back and no refusal came: Ultracopier took the job
+            }
+        }
+    }
+    return false;
+}
